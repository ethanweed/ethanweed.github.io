@article{weedDifferentDifferentWays2023,
  title = {Different in {{Different Ways}}: {{A Network-Analysis Approach}} to {{Voice}} and {{Prosody}} in {{Autism Spectrum Disorder}}},
  shorttitle = {Different in {{Different Ways}}},
  author = {Weed, Ethan and Fusaroli, Riccardo and Simmons, Elizabeth and Eigsti, Inge-Marie},
  year = 2023,
  month = apr,
  journal = {Language Learning and Development},
  pages = {1--18},
  issn = {1547-5441, 1547-3341},
  doi = {10.1080/15475441.2023.2196528},
  urldate = {2023-05-06},
  abstract = {The current study investigated whether the difficulty in finding group differ\- ences in prosody between speakers with autism spectrum disorder (ASD) and neurotypical (NT) speakers might be explained by identifying different acous\- tic profiles of speakers which, while still perceived as atypical, might be characterized by different acoustic qualities. We modelled the speech from a selection of speakers (N = 26), with and without ASD, as a network of nodes defined by acoustic features. We used a community-detection algorithm to identify clusters of speakers who were acoustically similar and compared these clusters with atypicality ratings by na\"ive and expert human raters. Results identified three clusters: one primarily composed of speakers with ASD, one of mostly NT speakers, and one comprised of an even mixture of ASD and NT speakers. The human raters were highly reliable at distinguishing speakers with and without ASD, regardless of which cluster the speaker was in. These results suggest that community-detection methods using a net\- work approach may complement commonly-employed human ratings to improve our understanding of the intonation profiles in ASD.},
  langid = {english},
  file = {/Users/ethan/Zotero/storage/YXQPNI2S/Weed et al. - 2023 - Different in Different Ways A Network-Analysis Ap.pdf}
}

@inproceedings{weedPerceptualConsensusNeurotypes2026,
  title = {Perceptual {{Consensus}} across {{Neurotypes}}: {{INSAR}} 2026},
  shorttitle = {Perceptual {{Consensus}} across {{Neurotypes}}},
  author = {Weed, Ethan and Groves, Elana and Fusaroli, Riccardo and Grossman, Ruth},
  year = 2026,
  abstract = {Background: The double empathy problem suggests that communication breakdowns between autistic and non-autistic people are a bidirectional issue, stemming from a mismatch in interaction styles and understanding (Milton, 2012). A key, yet underexplored, aspect of this theory is whether fundamental perceptions of speech differ across neurotypes. It remains unclear if autistic and non-autistic listeners agree on what makes speech engaging or preferable, and which specific acoustic features---such as vocal pitch, intensity, or fluency---drive these judgments. This study aims to directly test how autistic and non-autistic listeners perceive thin slices (Grossman et al, 2015) of autistic and non-autistic storytelling. Objectives: First, we tested the hypothesis that autistic and non-autistic raters would agree in their perceptual judgments of thin slices of autistic and non-autistic narrative speech (Q1). Second, we predicted reliable differences in ratings assigned to thin slices based on speaker neurotype (autistic vs. non-autistic) (Q2). Finally, we aimed to identify which specific acoustic features of the speech samples were the strongest predictors of more favorable ratings across rater groups (Q3). Methods: 30 speakers (15 autistic, 15 non-autistic) were recorded talking about a recent vacation or trip. For each speaker, we selected a 10-second clip, starting as close as possible to after the full minute of narration. Each thin-slice clip was rated by 150 raters (75 autistic via SPARK and 75 non-autistic via Prolific. Raters used ungraduated slider bars to indicate their agreement with four statements, such as ``The person is enthusiastic about the topic'' or ``I would enjoy listening to this person read me a story.'' From each clip, we extracted four acoustic measures: Pitch IQR, Percent Pause, Spaciousness, and Wiggliness (Wehrle et al, 2020). Each of our three research questions was addressed with a separate Bayesian linear model. Results: Autistic and Non-autistic raters were nearly unanimous in their ratings (Bayesian R2 = .99) (Q1), and there was no reliable difference in ratings of autistic and non-autistic speakers (mean diff effect size autistic raters = 5.2 [CI: -3.23 - 13.40], mean diff effect size non autistic raters = 5.89 [CI: -5.47 - 17.36] (Q2). When collapsed over rater and speaker group, only spaciousness reliably predicted preference (effect size 6.78 [CI: 2.24 - 11.33] (Q3) (Figure 1). Conclusions: Autistic and non-autistic raters agree in their ratings of thin-slices of narrative speech samples, suggesting shared perceptual preferences, specifically for spaciousness, i.e. wider ranges in pitch ``jumps'' during narratives that seem to be interpreted as indicating engagement and enthusiasm. This finding demonstrates that differences in perception or preference of prosodic features are unlikely to be the primary driver of communication breakdowns between neurotypes. References Grossman, R. B. (2015). Judgments of social awkwardness from brief exposure to children with and without high-functioning autism. Autism, 19(5), 580--587. https://doi.org/10.1177/1362361314536937 Milton, D. E. M. (2012). On the ontological status of autism: The `double empathy problem.' Disability \& Society, 27(6), 883--887. https://doi.org/10.1080/09687599.2012.710008 Wehrle, S., Cangemi, F., Hanekamp, H., Vogeley, K., \& Grice, M. (2020). Assessing the Intonation Style of Speakers with Autism Spectrum Disorder. Speech Prosody 2020, 809--813. https://doi.org/10.21437/SpeechProsody.2020-165},
  file = {/Users/ethan/Zotero/storage/TFV6ZHCP/Weed et al. - 2026 - Perceptual Consensus across Neurotypes INSAR 2026.pdf}
}

@article{zaneNormalDifferentAutistic2024,
  title = {Normal but {{Different}}: {{Autistic Adolescents Who Score Within Normal Ranges}} on {{Standardized Language Tests Produce Frequent Linguistic Irregularities}} in {{Spontaneous Discourse}}},
  shorttitle = {Normal but {{Different}}},
  author = {Zane, Emily R and Grossman, Ruth B},
  year = 2024,
  month = jan,
  journal = {Autism \& Developmental Language Impairments},
  volume = {9},
  pages = {23969415241283378},
  issn = {2396-9415, 2396-9415},
  doi = {10.1177/23969415241283378},
  urldate = {2024-09-27},
  abstract = {Background and aims: A substantial minority of autistic individuals score within typical ranges on standard language tests, suggesting that autism does not necessarily affect language acquisition. This idea is reflected in current diagnostic criteria for autism, wherein language impairment is no longer included. However, some work has suggested that probing autistic speakers' language carefully may reveal subtle differences between autistic and nonautistic people's language that cannot be captured by standardized language testing. The current study aims to test this idea, by determining whether a group of autistic and nonautistic individuals who score similarly on a standardized test show differences in the number of unconventional and erroneous language features they produce in a spontaneous language sample. Methods: Thirty-eight older children and adolescents (19 autistic; 19 nonautistic), between the ages of 10 and 18, were recruited. Both participant groups scored within normal ranges on standardized language and IQ tests. Participants engaged in a ``double interview'' with an experimenter, during which they were first asked questions by the experimenter about themselves, and then they switched roles, so that it was the participant's turn to ask the experimenter questions. Participants' language during the interview was transcribed and analyzed for linguistic irregularities, including both semantic anomalies and morphosyntactic errors. Results: Group membership accounted for significant variance in irregularity frequency; autistic participants produced more linguistic irregularities than nonautistic participants. Scores on a standardized language test did not improve model fit. Secondary analyses involving irregularity type (semantic vs. morphosyntactic) showed that group differences were primarily driven by relatively high numbers of semantic unconventionalities produced by the autistic group. While the autistic group made more morphosyntactic errors than the nonautistic group, differences in these numbers were only marginally significant. Conclusions and implications: These findings suggest that a commonly used standardized language test does not adequately predict the number and perhaps type of language irregularities produced by some older autistic children and adolescents during spontaneous discourse. Results also suggest that differences in language use, especially semantic differences, may characterize autistic language, even the language produced by people who score within normal ranges on standardized language tests. It is debatable whether differences reflect underlying language impairments and/or a linguistic style adopted/preferred by autistic speakers. In this paper, we discuss both possibilities and offer suggestions to future research for teasing these possibilities apart.},
  langid = {english},
  file = {/Users/ethan/Zotero/storage/B3QQE2BW/Zane and Grossman - 2024 - Normal but Different Autistic Adolescents Who Sco.pdf}
}
